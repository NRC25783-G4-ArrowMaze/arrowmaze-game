#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/jr_g/Develop/arrowmaze-game/node_modules/.pnpm/node-nailgun-server@0.1.4/node_modules/node-nailgun-server/node_modules:/home/jr_g/Develop/arrowmaze-game/node_modules/.pnpm/node-nailgun-server@0.1.4/node_modules:/home/jr_g/Develop/arrowmaze-game/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/jr_g/Develop/arrowmaze-game/node_modules/.pnpm/node-nailgun-server@0.1.4/node_modules/node-nailgun-server/node_modules:/home/jr_g/Develop/arrowmaze-game/node_modules/.pnpm/node-nailgun-server@0.1.4/node_modules:/home/jr_g/Develop/arrowmaze-game/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../node-nailgun-server/index.js" "$@"
else
  exec node  "$basedir/../node-nailgun-server/index.js" "$@"
fi
