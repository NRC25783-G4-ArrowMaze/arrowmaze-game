@startuml
class Port {
    -index: number
    +getIndex(): number
}
class TopologyError extends Error
class BoardRegistryError extends Error
class ConnectionError extends Error
class LevelDataError extends Error
class BoardMutationError extends Error
class Cell {
    -id: string
    -portCount: number
    -ports: readonly Port[]
    -connections: Map<number, { neighborCell: Cell; neighborPortIndex: number; }>
    -arrowSegment: { isHead: boolean; cellId: string; }
    -occupied: boolean
    +getId(): string
    +getPortCount(): number
    +getPortAtIndex(index: number): Port
    +getNeighborAtPort(portIndex: number): Cell
    +getConnection(portIndex: number): { neighbor: Cell; neighborPortIndex: number; }
    +isExit(portIndex: number): boolean
    +canConnect(portIndex: number): boolean
    +_getNeighborPortIndex(portIndex: number): number
    +_connectToNeighbor(portIndex: number, neighborCell: Cell, neighborPortIndex: number): void
    +_disconnectFromNeighbor(portIndex: number): void
    +hasArrowSegment(): boolean
    +isOccupied(): boolean
    +getArrowSegment(): { isHead: boolean; cellId: string; }
    +placeArrowSegment(segment: { isHead: boolean; cellId: string; }): void
    +removeArrowSegment(): void
}
class TopologyValidator {
    +{static} validateEvenPortCount(portCount: number): void
    +{static} validatePortIndex(portIndex: number, portCount: number): void
    +{static} validateNoSelfConnect(cellA: Cell, cellB: Cell): void
}
class Board {
    -id: string
    -cells: Map<string, Cell>
    +getId(): string
    +getAllCells(): Cell[]
    +getCell(id: string): Cell
    +addCell(cell: Cell): void
    +removeCell(cellId: string): void
    +connectPorts(cellA: Cell, portIndexA: number, cellB: Cell, portIndexB: number): void
    +disconnectPort(cell: Cell, portIndex: number): void
}
interface PlaceArrowInput {
    +board: Board
    +headCellId: string
    +exitPort: number
    +bodyCellIds?: string[]
}
interface ArrowSegmentDTO {
    +cellId: string
    +isHead: boolean
    +exitPort: number
    +entryPort: number
}
interface PlaceArrowResult {
    +success: boolean
    +arrowLength: number
    +segments: ArrowSegmentDTO[]
    +error?: string
}
interface CellDTO {
    +id: string
    +portCount: number
    +isOccupied: boolean
}
interface ConnectionDTO {
    +fromCellId: string
    +fromPort: number
    +toCellId: string
    +toPort: number
}
interface LoadLevelResult {
    +success: boolean
    +levelId: string
    +cells: CellDTO[]
    +connections: ConnectionDTO[]
    +error?: string
}
interface LevelCellDTO {
    +id: string
    +portCount: number
}
interface LevelConnectionDTO {
    +fromCell: string
    +fromPort: number
    +toCell: string
    +toPort: number
}
interface LevelArrowDTO {
    +id: string
    +head: { cellId: string; exitPort: number; }
    +body: string[]
}
interface LevelDataDTO {
    +id: string
    +name?: string
    +difficulty?: string
    +allowedMoves: number
    +arrows: LevelArrowDTO[]
    +cells: LevelCellDTO[]
    +connections?: LevelConnectionDTO[]
}
abstract class ArrowSegment {
    +cell: Cell
    +prev: ArrowSegment
    +next: ArrowSegment
    +{abstract} isHead: boolean
    +getCellId(): string
}
class Head extends ArrowSegment {
    +isHead: true
    +exitPort: number
}
class Segment extends ArrowSegment {
    +isHead: false
    +entryPort: number
}
class ArrowPlacementError extends Error
class ArrowCreationError extends Error
class ArrowCinematicError extends Error
interface AdvanceResult {
    +outcome: AdvanceOutcome
    +freedCellIds: readonly string[]
    +occupiedCellIds: readonly string[]
}
class Arrow {
    -_head: Head
    -_inFlight: boolean
    +head: Head
    +length: number
    +extend(nextCell: Cell): void
    +destroy(): void
    +advance(): AdvanceResult
    -_collectChain(): ArrowSegment[]
    -_calculateTargets(chain: ArrowSegment[]): { segment: ArrowSegment; exitDir: number; targetCell: Cell | null; }[]
    -_commitAdvance(chain: ArrowSegment[], targets: { segment: ArrowSegment; exitDir: number; targetCell: Cell | null; }[]): AdvanceResult
    -_getTail(): ArrowSegment
    -_findConnectingPort(fromCell: Cell, toCell: Cell): number
    -_cellBelongsToSelf(cell: Cell): boolean
}
interface AdvanceArrowInput {
    +board: Board
    +arrow: Arrow
}
interface AdvanceResultDTO {
    +success: boolean
    +outcome: AdvanceOutcome
    +segments: ArrowSegmentDTO[]
    +freedCellIds: string[]
    +occupiedCellIds: string[]
    +arrowLength: number
    +error?: string
}
class NoMovesRemainingError extends Error
class GameAlreadyFinishedError extends Error
class ScoringTracker {
    -_ticksUsed: number
    -_totalFails: number
    -_consecutiveFails: number
    -_accumulatedPenalty: number
    +ticksUsed: number
    +totalFails: number
    +consecutiveFails: number
    +accumulatedPenalty: number
    +recordTick(): void
    +recordSuccess(): void
    +recordFailure(): void
}
class Score {
    +timeScore: number
    +penaltyTotal: number
    +flawlessVictory: boolean
    +finalScore: number
    +{static} compute(tracker: ScoringTracker): Score
    +{static} createSimpleScore(value: number): Score
}
class GameSession {
    -_movesRemaining: number
    -_status: GameStatus
    -_scoringTracker: ScoringTracker
    -_score: Score
    +movesRemaining: number
    +status: GameStatus
    +score: Score
    +consumeMove(): void
    +recordMoveOutcome(moveSucceeded: boolean): void
    +evaluateStatus(board: Board): GameStatus
}
interface PlayMoveInput {
    +session: GameSession
    +board: Board
    +arrow: Arrow
}
interface PlayMoveResult {
    +success: boolean
    +outcome?: "advanced" | "blocked" | "destroyed"
    +movesRemaining: number
    +gameStatus: GameStatus
    +score?: number
    +error?: string
}
interface SlideInput {
    +session: GameSession
    +board: Board
    +arrow: Arrow
}
interface SlideResult {
    +success: boolean
    +trajectory: AdvanceOutcome[]
    +finalOutcome?: AdvanceOutcome
    +movesRemaining: number
    +gameStatus: GameStatus
    +score?: number
    +error?: string
}
interface IArrowBuilder {
    +buildAll(board: Board, arrowDTOs: LevelArrowDTO[]): Arrow[]
}
interface IAuthTokenProvider {
    +getToken(): Promise<string>
}
interface IBoardBuilder {
    +build(data: LevelDataDTO): Board
}
class InvalidLevelProgressError extends Error
class LevelProgress {
    -_levelId: string
    -_score: Score
    -_movesUsed: number
    -_timeElapsedSeconds: number
    -_achievedAt: Date
    +levelId: string
    +score: Score
    +movesUsed: number
    +timeElapsedSeconds: number
    +achievedAt: Date
    +isBeatenBy(newScore: Score, newMovesUsed: number, newTimeElapsedSeconds: number): boolean
    +{static} create(levelId: string, score: Score, movesUsed: number, timeElapsedSeconds: number, achievedAt?: Date): LevelProgress
}
interface ILocalProgressRepository {
    +initialize(): Promise<void>
    +findByLevelId(levelId: string): Promise<LevelProgress>
    +findAll(): Promise<LevelProgress[]>
    +save(progress: LevelProgress): Promise<void>
    +findPendingSync(): Promise<LevelProgress[]>
    +markAsSynced(levelId: string): Promise<void>
}
interface IProgressApiClient {
    +pushProgress(progress: LevelProgress): Promise<void>
    +fetchUserProgress(): Promise<LevelProgress[]>
}
class LevelDataArrowBuilder implements IArrowBuilder {
    +buildAll(board: Board, arrowDTOs: LevelArrowDTO[]): Arrow[]
}
class LevelDataBoardBuilder implements IBoardBuilder {
    +build(data: LevelDataDTO): Board
    -validateBaseStructure(data: LevelDataDTO): void
    -validateCellData(cellData: LevelCellDTO): void
    -processConnection(board: Board, conn: LevelConnectionDTO): void
    -validateOppositePorts(fromCell: Cell, fromPort: number, toCell: Cell, toPort: number): void
    -validateArrowIntegrity(board: Board, arrow: LevelArrowDTO): void
}
class AdvanceArrowUseCase {
    +execute(input: AdvanceArrowInput): AdvanceResultDTO
    -_projectChain(head: ArrowSegment): ArrowSegmentDTO[]
}
class BuildBoardUseCase {
    -builder: IBoardBuilder
    +execute(levelData: LevelDataDTO): Board
}
class GetLocalProgress {
    -_repository: ILocalProgressRepository
    +getAll(): Promise<LevelProgress[]>
    +getByLevel(levelId: string): Promise<LevelProgress>
}
interface LoadedLevel {
    +board: Board
    +arrows: Arrow[]
}
interface ILoadedLevelRepository {
    +getLoadedLevel(levelId: string): Promise<LoadedLevel>
}
class LevelLoader {
    -boardBuilder: IBoardBuilder
    -arrowBuilder: IArrowBuilder
    +load(data: LevelDataDTO): LoadedLevel
}
class PlaceArrowUseCase {
    +execute(input: PlaceArrowInput): PlaceArrowResult
    -_projectChain(head: ArrowSegment): ArrowSegmentDTO[]
}
class PlayMoveUseCase {
    -advanceUseCase: AdvanceArrowUseCase
    +execute(input: PlayMoveInput): PlayMoveResult
}
class TopologyQueryService {
    +getNeighborCell(cell: Cell, portIndex: number): Cell
    +isExit(cell: Cell, portIndex: number): boolean
    +getAdjacentCells(cell: Cell): Cell[]
}
class PathChecker {
    -{static} queryService: TopologyQueryService
    +{static} canReachExit(startCell: Cell): boolean
}
class QueryTopologyUseCase {
    -queryService: TopologyQueryService
    +getAdjacentCells(board: Board, cellId: string): CellDTO[]
    +isExitPort(board: Board, cellId: string, portIndex: number): boolean
    +canReachExit(board: Board, cellId: string): boolean
    -resolveCell(board: Board, cellId: string): Cell
}
class SaveLocalProgress {
    -_repository: ILocalProgressRepository
    +execute(levelId: string, finalScore: Score, movesUsed: number, timeElapsedSeconds: number): Promise<void>
}
class SlideArrowUseCase {
    -advanceUseCase: AdvanceArrowUseCase
    +execute(input: SlideInput): SlideResult
}
class SyncOfflineProgress {
    -_repository: ILocalProgressRepository
    +getPendingSyncRecords(): Promise<LevelProgress[]>
    +markAsSynced(levelId: string): Promise<void>
}
class SessionExpiredError extends Error
class NetworkError extends Error
class SyncProgress {
    -_localRepository: ILocalProgressRepository
    -_apiClient: IProgressApiClient
